+		NVIC_ClearPendingIRQ(ESB_RADIO_IRQ_NUMBER);
+	}
+	if (!IS_ENABLED(CONFIG_ESB_MPSL_RADIO)) {
+		irq_enable(ESB_RADIO_IRQ_NUMBER);
+	}
 
