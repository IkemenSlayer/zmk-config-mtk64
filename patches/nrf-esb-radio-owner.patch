@@ -1832,7 +1836,9 @@
 
 static void esb_irq_disable(void)
 {
-	irq_disable(ESB_RADIO_IRQ_NUMBER);
+	if (!IS_ENABLED(CONFIG_ESB_MPSL_RADIO)) {
+		irq_disable(ESB_RADIO_IRQ_NUMBER);
+	}
 	irq_disable(ESB_EVT_IRQ_NUMBER);
 	irq_disable(ESB_TIMER_IRQ);
 }
@@ -1899,15 +1905,19 @@
 	/* Ensure IRQs are disabled before attaching. */
 	esb_irq_disable();
 
