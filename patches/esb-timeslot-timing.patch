+/* Only called from START/TIMER0/EXTEND_SUCCEEDED while MPSL grants access.
+ * Closing a session does not end an already running slot for the application.
+ */
+static void end_current_timeslot(void) {
+    nrf_timer_int_disable(NRF_TIMER0, NRF_TIMER_INT_COMPARE0_MASK |
+                                    NRF_TIMER_INT_COMPARE1_MASK);
+    nrf_timer_event_clear(NRF_TIMER0, NRF_TIMER_EVENT_COMPARE0);
+    nrf_timer_event_clear(NRF_TIMER0, NRF_TIMER_EVENT_COMPARE1);
+    set_timeslot_active_status(false);
+    signal_callback_return_param.callback_action = MPSL_TIMESLOT_SIGNAL_ACTION_END;
+}
